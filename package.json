{
  "name": "bx24-template-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Starter template for building Model Context Protocol servers on Bitrix24 — example tools for tasks and users, plus the auth, throttling, and test scaffolding to fork and extend with your own.",
  "author": "Bitrix24",
  "homepage": "https://github.com/bitrix24/templates-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitrix24/templates-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bitrix24/templates-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "scripts": {
    "build": "nuxt build",
    "build:dxt": "node mcp-stdio/build.mjs",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:evals": "evalite"
  },
  "dependencies": {
    "@bitrix24/b24icons-vue": "^2.0.8",
    "@bitrix24/b24jssdk": "^1.3.0",
    "@bitrix24/b24jssdk-nuxt": "^1.3.0",
    "@bitrix24/b24ui-nuxt": "^2.15.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nuxtjs/mcp-toolkit": "^0.17.2",
    "better-sqlite3": "12.11.1",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.130",
    "@anthropic-ai/mcpb": "^2.1.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/vite-builder": "^4.6.2",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "ai": "^6.0.311",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "evalite": "^0.19.0",
    "h3": "^1.15.11",
    "rolldown": "^1.2.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "keywords": [
    "bitrix24",
    "bitrix24-api",
    "bitrix24-rest",
    "b24",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "anthropic",
    "ai-agent",
